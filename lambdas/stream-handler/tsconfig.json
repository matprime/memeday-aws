{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    // Matches the projectRoot CDK's NodejsFunction already bundles this
    // Lambda from (see infra/lib/memeday-stack.ts) — needed since KAN-101
    // imports lib/points-config.ts from the repo root.
    "rootDir": "../.."
  },
  "exclude": ["node_modules", "dist"]
}
