# Two files, by design. .env.local overrides .env (Next.js precedence, and test/*.test.js
# loads them in the same order). Both are gitignored.
#
#   .env        deploy-only — what infra/ CDK commands need (dotenv -e ../.env -- npx cdk ...)
#   .env.local  per-stack app vars for local dev — copy them from the stack outputs:
#                 aws cloudformation describe-stacks --stack-name MemeDayDev --region eu-west-1
#
# Deployments don't use either file; set the app vars in the Vercel project settings.
# Keeping app vars out of .env means a missing .env.local fails loud in lib/dynamo.ts
# instead of silently reading the wrong stack.

# ─── .env ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=eu-west-1

# Random secret used to sign wallet auth nonces and derive per-wallet passwords.
# Generate with: openssl rand -hex 32
# Changing it invalidates existing wallet_* logins in that Cognito pool.
WALLET_AUTH_SECRET=changeme_generate_with_openssl_rand_hex_32

# Comma-separated. Subscribed to the SNS alarm topic at CDK deploy time
# (infra/bin/app.ts). Only read during deploys, so it belongs here, not in .env.local.
ALERT_EMAILS=you@example.com

# ─── .env.local ──────────────────────────────────────────────────────────────
# Everything below is per-stack: the same key holds a different value in dev and prod.
# That is the whole reason for the split — .env above is stack-agnostic and safe to
# share between them, these are not.
#
#   local dev / testing  →  MemeDayDev stack   (table MemeDayDev, memeday-alerts-dev)
#   production           →  MemeDayStack       (table MemeDayProd, memeday-alerts)
#
# Never point .env.local at the prod stack — the dev branch would read and write live
# data. Prod values belong in the Vercel project settings, not in any local file.
#
# Repeated here on purpose: every AWS client falls back to us-east-1 when unset.
AWS_REGION=eu-west-1

# MemeDayDev for local dev; MemeDayProd is the production table.
DYNAMODB_TABLE_NAME=MemeDayDev

# User Pool ID and App Client ID — MemeDayDev stack outputs UserPoolId / UserPoolClientId
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Meme image bucket — the stack's BucketName output, not the cdk-hnb659fds-assets-* bucket
S3_BUCKET_NAME=memedaydev-memedaybucket-xxxxxxxxxxxx
# CloudFront distribution domain (without https://).
# Leave blank to serve images through /api/image/<key> instead.
CLOUDFRONT_DOMAIN=

# SNS alerts topic ARN — the stack's AlertTopicArn output (KAN-43 report/
# takedown notifications; also where the KAN-19 rate-limit-counter-failure
# alarm publishes).
SNS_ALERTS_TOPIC_ARN=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics — see docs/ANALYTICS_EVENTS.md.
# Leave POSTHOG_KEY blank locally: track() no-ops and nothing is sent.
# To verify wiring locally, paste the production key here — the free tier is one
# project, so dev and prod share it. Every event carries environment=NODE_ENV, and
# insights filter on environment = "production" to exclude local clicks.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Solana network config — see README and lib/solana/network.ts (the single
# choke point every RPC/mint/tip/wallet code path imports from). All three
# are required; missing or invalid values fail loudly at import time.

# "devnet" or "mainnet". mainnet is only allowed when VERCEL_ENV=production
# (Vercel-injected, never set manually) — every other environment rejects it.
SOLANA_NETWORK=

# RPC endpoint for the network above. SERVER-ONLY: this is never handed to the
# browser. A paid provider URL carries its API key, so the client is given the
# /api/rpc proxy path instead (app/api/rpc/route.ts forwards to this value).
# Mainnet must use a paid provider free tier, not the public endpoint, which is
# rate-limited and unreliable. Also set an origin access rule on the key in the
# provider dashboard as a second layer.
SOLANA_RPC_URL=

# Kill switch for all on-chain features (tips, mint, resale). "true" or
# "false" — set false in Vercel to disable without a code change/redeploy.
SOLANA_ENABLED=
